      "properties": {
        "citation_eligibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "formalism_metadata": {
          "type": [
            "object",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "passage_id": {
          "type": "string"
        },
        "provenance_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "seminar": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_layer": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminology_metadata": {
          "type": [
            "object",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "witness": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "passage_id"
      ],
      "title": "EvidencePacket",
      "type": "object"
    }
  },
  "$id": "passage-search-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Phase 4D.0 稳定对象 13/15：检索结果",
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidencePacket"
      },
      "type": "array"
    },
    "filters": {
      "type": [
        "object",
        "null"
      ]
    },
    "n": {
      "type": "integer"
    },
    "query": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": [
          "string",
          "object"
        ]
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "query",
    "evidence",
    "n"
  ],
  "title": "PassageSearchResult",
  "type": "object"
}